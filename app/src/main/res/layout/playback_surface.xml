<?xml version="1.0" encoding="utf-8"?>
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:animation_enabled="false"
    app:controller_layout_id="@layout/playback_transport"
    app:fullscreen_enter_icon="@drawable/ic_oui_expand"
    app:fullscreen_exit_icon="@drawable/ic_oui_fit_to_screen"
    app:pause_icon="@drawable/ic_oui_control_pause_circle_filled"
    app:play_icon="@drawable/ic_oui_control_play_circle_filled"
    app:show_buffering="when_playing"
    app:shutter_background_color="@android:color/black"
    app:subtitle_off_icon="@drawable/ic_oui_live_caption"
    app:subtitle_on_icon="@drawable/ic_oui_live_caption" />
