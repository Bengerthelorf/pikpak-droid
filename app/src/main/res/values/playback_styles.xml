<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="playback_unknown_duration" translatable="false">--:--</string>
    <item name="playback_quality_icon" type="drawable">@drawable/ic_oui_screen_resolution</item>

    <style name="PlaybackControl" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/sesl_action_bar_item_background</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">?android:attr/textColorPrimary</item>
    </style>
    <style name="PlaybackSkip" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/sesl_action_bar_item_background</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:drawableTint">?android:attr/textColorPrimary</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">3dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="PlaybackTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
